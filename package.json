{
  "name": "kora",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "pnpm --filter @kora/db migrate",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @kora/web build",
    "db:smoke": "bash infra/smoke.sh",
    "dev:all": "pnpm -r --parallel --filter @kora/web --filter @kora/worker --filter @kora/mock-gsp dev",
    "e2e": "pnpm --filter @kora/e2e e2e"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
