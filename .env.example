# Copy to .env for local development. Never commit real values.
# Everything below the "LIVE SERVICES" line is optional: leave it out and Kora uses safe local mocks.

# ------------------------------------------------------------------ core (needed to run)
DATABASE_URL=postgres://kora_web:kora_web_dev@localhost:54329/kora
MIGRATE_DATABASE_URL=postgres://kora_owner:kora_owner_dev@localhost:54329/kora
TEST_ADMIN_URL=postgres://postgres:kora_admin_dev@localhost:54329/postgres
OTP_HMAC_SECRET=dev-only-change-me-32-bytes-minimum-xxxx
SESSION_TTL_DAYS=30
APP_URL=http://localhost:3000

# 'mock' prints one-time codes to the server console and sends nothing. 'live' uses MSG91 (SMS) and Resend (email), set up below.
OTP_PROVIDER=mock
# 'mock' keeps messages in memory and logs them. 'live' sends through WhatsApp Cloud API, Resend and MSG91.
MESSENGER=mock
# 'mock' sends test payment links to a page in this app. 'razorpay' uses Razorpay Payment Links.
GATEWAY=mock
GATEWAY_WEBHOOK_SECRET=dev-only-gateway-secret-change-me-32
# GST partner. The mock partner app (pnpm --filter @kora/mock-gsp start) speaks the same JSON as a real one.
GSP_URL=http://127.0.0.1:3202
# GSP_TOKEN=

# Staging demo only: every sign-in code becomes this value. Needs KORA_ALLOW_MOCKS=1. NEVER set it with real customers.
# DEMO_FIXED_OTP=123456
# Production refuses every mock unless this is 1. Use it only for a staging demo.
# KORA_ALLOW_MOCKS=1

# ------------------------------------------------------------------ LIVE SERVICES (fill in what you have)

# --- SMS sign-in codes and SMS messages: MSG91 (https://msg91.com). Needs a DLT-approved template with one variable.
# OTP_PROVIDER=live
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=          # template whose variable is named OTP (change the name with MSG91_OTP_VAR)
# MSG91_SMS_TEMPLATE_ID=          # template whose variable is named MESSAGE (change with MSG91_SMS_VAR)

# --- Email (sign-in codes and invoices): Resend (https://resend.com). The sender domain must be verified there.
# RESEND_API_KEY=
# EMAIL_FROM="Kora <billing@yourdomain.com>"

# --- WhatsApp: Meta WhatsApp Cloud API. Messages to customers must use an approved template with ONE body variable.
# MESSENGER=live
# WHATSAPP_TOKEN=                 # permanent access token of a system user
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=invoice_share
# WHATSAPP_TEMPLATE_LANG=en

# --- Payments: Razorpay. In the Razorpay dashboard add a webhook to {APP_URL}/api/webhooks/razorpay, tick "payment_link.paid",
#     and use the same secret below.
# GATEWAY=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Rate limiting that works across several servers: Upstash Redis (https://upstash.com), REST API. Without it Postgres is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# API_RATE_PER_MINUTE=300         # per IP address, across all API routes

# --- Files in object storage instead of the database: Cloudflare R2, Backblaze B2, AWS S3 or MinIO (S3 compatible).
# BLOB_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BLOB_S3_BUCKET=
# BLOB_S3_ACCESS_KEY_ID=
# BLOB_S3_SECRET_ACCESS_KEY=
# BLOB_S3_REGION=auto

# --- Error reporting: Sentry (https://sentry.io). Errors go to the log either way.
# SENTRY_DSN=
# LOG_LEVEL=info                  # debug, info, warn or error

# --- A scheduler with no always-on worker (Vercel and similar): GET /api/cron/tick with 'Authorization: Bearer <this>'.
#     Without it the route refuses everyone. Use 16 or more random characters.
# CRON_SECRET=

# --- Backups (used by infra/backup.sh and the GitHub workflow, not by the app)
# BACKUP_DATABASE_URL=
# BACKUP_PASSPHRASE=
# BACKUP_S3_URI=s3://bucket/kora
# BACKUP_S3_ENDPOINT=
