# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://kora_web:kora_web_dev@localhost:54329/kora
MIGRATE_DATABASE_URL=postgres://kora_owner:kora_owner_dev@localhost:54329/kora
TEST_ADMIN_URL=postgres://postgres:kora_admin_dev@localhost:54329/postgres
# 'mock' prints one-time codes to the server console. Refused when NODE_ENV=production.
OTP_PROVIDER=mock
OTP_HMAC_SECRET=dev-only-change-me-32-bytes-minimum-xxxx
SESSION_TTL_DAYS=30
# Payment gateway. 'mock' sends test links to a page in this app. Refused in production unless KORA_ALLOW_MOCKS=1.
GATEWAY=mock
GATEWAY_WEBHOOK_SECRET=dev-only-gateway-secret-change-me-32
APP_URL=http://localhost:3000
# GST partner. The mock partner app (pnpm --filter @kora/mock-gsp start) speaks the same JSON as a real one.
GSP_URL=http://127.0.0.1:3202
# GSP_TOKEN=
MESSENGER=mock
